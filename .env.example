# Copy to .env.local for local development, and set the same keys in
# Vercel -> Project -> Settings -> Environment Variables for production.
# Never commit .env / .env.local — only this template is tracked.

# --- Site origin --------------------------------------------------------------
# Canonical origin, no trailing slash. Only needed to override the production
# default (https://www.amanapartnersllc.com) — e.g. on a preview deployment.
# VITE_SITE_URL=https://www.amanapartnersllc.com

# --- Contact form delivery (Hostinger SMTP) ---------------------------------
# Password of the contact@amanapartnersllc.com mailbox. REQUIRED — without it
# the /api/contact endpoint returns 503 and the form shows its error state.
SMTP_PASSWORD=

# Optional — these fall back to the values shown.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=contact@amanapartnersllc.com
# CONTACT_TO=contact@amanapartnersllc.com

# --- Error reporting (optional) --------------------------------------------
# If set, client-side crashes are POSTed here (see src/lib/report-error.ts).
# Remember to add the host to `connect-src` in the CSP in src/server.ts.
# VITE_ERROR_REPORT_URL=
